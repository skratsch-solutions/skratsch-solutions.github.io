---
interface Props {
  description: string
  nodes: string[]
}

const { description, nodes } = Astro.props
---

<figure class="system-diagram" aria-label={description}>
  <div class="system-diagram-track" aria-hidden="true">
    {nodes.map((node, index) => (
      <div class="system-diagram-node">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{node}</strong>
      </div>
    ))}
  </div>
  <figcaption>{description}</figcaption>
</figure>
