---
import type { CollectionEntry } from 'astro:content'
import { getPostRoute } from '../lib/post-routes'

interface Props {
  postEntry: CollectionEntry<'posts'>
}

const { postEntry } = Astro.props
const postCategories = Array.isArray(postEntry.data.categories)
  ? postEntry.data.categories
  : postEntry.data.categories
    ? [postEntry.data.categories]
    : []
---

<article class="post-card">
  {postEntry.data.image && <img class="post-card-image" src={postEntry.data.image} alt="" loading="lazy" decoding="async" />}
  <div class="post-card-copy">
    <div class="post-card-meta">
      <time datetime={postEntry.data.date.toISOString()}>{postEntry.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
      {postCategories.length > 0 && <span>{postCategories.join(' / ')}</span>}
    </div>
    <h2 class="post-card-title"><a href={getPostRoute(postEntry)}>{postEntry.data.title}</a></h2>
    {postEntry.data.excerpt && <p class="post-card-excerpt">{postEntry.data.excerpt}</p>}
  </div>
</article>
