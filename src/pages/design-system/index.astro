---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { capabilityGroups } from '../../lib/site-constants'

const tokens = [
  ['Ink', '#0B1110'],
  ['Panel', '#13201E'],
  ['Paper', '#F7F1E6'],
  ['Amber', '#E4A735'],
  ['Copper', '#AD5337'],
  ['Steel', '#5D8791'],
  ['Signal', '#79C496'],
]
---
<BaseLayout
  title="Design System | Skratsch Solutions"
  description="The production-native Skratsch Solutions design-system reference."
>
  <section class="shell reference-hero">
    <div class="status-label"><span class="status-dot"></span><span>PRODUCTION REFERENCE · V0.2</span></div>
    <p class="section-kicker">DESIGN SYSTEM</p>
    <h1 class="hero-title">Warm precision, tested in the real site.</h1>
    <p class="hero-lede">
      This Astro-native reference renders the same tokens, assets, components, breakpoints, and theme behavior used by Skratsch.com.
      It is the working contract for content and interface changes.
    </p>
    <div class="button-row">
      <a class="button-primary" href="/run/">View canonical RUN experience</a>
      <a class="button-secondary" href="/?theme=light">Preview light theme</a>
    </div>
  </section>

  <section class="shell reference-section" aria-labelledby="foundations">
    <div class="reference-heading">
      <p class="section-kicker">01 · FOUNDATIONS</p>
      <h2 id="foundations" class="section-title">Color and type</h2>
      <p class="section-copy">Amber marks action and focus. Steel routes information. Signal confirms healthy state. Paper and ink carry the reading experience.</p>
    </div>
    <div class="token-grid">
      {tokens.map(([name, value]) => (
        <article class="token-card">
          <span class="token-swatch" style={`background:${value}`}></span>
          <strong>{name}</strong>
          <code>{value}</code>
        </article>
      ))}
    </div>
    <div class="type-grid">
      <article class="reference-card">
        <span class="reference-label">Display · Space Grotesk</span>
        <p class="display-sample">Systems that work together.</p>
      </article>
      <article class="reference-card">
        <span class="reference-label">Body · IBM Plex Sans</span>
        <p class="body-sample">Clear service language connects technology decisions to practical operating outcomes.</p>
      </article>
    </div>
  </section>

  <section class="shell reference-section" aria-labelledby="actions">
    <div class="reference-heading">
      <p class="section-kicker">02 · ACTIONS AND STATE</p>
      <h2 id="actions" class="section-title">Buttons, focus, and status</h2>
    </div>
    <div class="reference-card action-stack">
      <div class="button-row">
        <a class="button-primary" href="/contact/">Primary action</a>
        <a class="button-secondary" href="#capabilities-reference">Secondary action</a>
      </div>
      <div class="state-row">
        <span class="status-label"><span class="status-dot"></span><span>OPERATING NORMALLY</span></span>
        <span class="state-chip state-chip--copper">Needs attention</span>
        <span class="state-chip state-chip--steel">Informational</span>
      </div>
      <p class="reference-note">Keyboard focus uses the amber focus ring. Motion is subtle and disabled when reduced motion is requested.</p>
    </div>
  </section>

  <section id="capabilities-reference" class="shell reference-section" aria-labelledby="capabilities-title">
    <div class="reference-heading">
      <p class="section-kicker">03 · CAPABILITY LANGUAGE</p>
      <h2 id="capabilities-title" class="section-title">RUN · IMPROVE · BUILD · UNDERSTAND</h2>
      <p class="section-copy">These labels are the primary public navigation and the organizing model for all service content.</p>
    </div>
    <div class="reference-capabilities">
      {capabilityGroups.map((capability) => (
        <a class="reference-capability" href={capability.href}>
          <img src={capability.icon} alt="" width="48" height="48" loading="lazy" decoding="async" />
          <span class="capability-kicker">{capability.kicker}</span>
          <strong>{capability.title}</strong>
          <p>{capability.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell reference-section" aria-labelledby="surfaces">
    <div class="reference-heading">
      <p class="section-kicker">04 · SURFACES AND EVIDENCE</p>
      <h2 id="surfaces" class="section-title">Panels should explain, not decorate</h2>
    </div>
    <div class="surface-grid">
      <article class="reference-card">
        <span class="reference-label">Signal card</span>
        <strong>Backup recovery path</strong>
        <p>Show the operating condition, the intervention, and the expected outcome.</p>
      </article>
      <article class="reference-card terminal-card">
        <span class="reference-label">Technical evidence</span>
        <code>$ skratsch verify systems<br />✓ identity aligned<br />✓ recovery tested<br />✓ owners assigned</code>
      </article>
      <article class="reference-card">
        <span class="reference-label">Field report</span>
        <strong>What changed and why</strong>
        <p>Use specific systems, decisions, and proof. Never manufacture metrics, clients, or testimonials.</p>
      </article>
    </div>
  </section>

  <section class="shell reference-section" aria-labelledby="imagery">
    <div class="reference-heading">
      <p class="section-kicker">05 · IMAGERY</p>
      <h2 id="imagery" class="section-title">Controlled hybrid system</h2>
      <p class="section-copy">Use technical illustration and interface/system visuals to explain services; use authentic photography where people, place, and proof matter.</p>
    </div>
    <div class="imagery-grid">
      <article class="imagery-slot imagery-slot--technical">
        <span>Technical illustration</span>
        <strong>Capabilities and operating models</strong>
      </article>
      <article class="imagery-slot imagery-slot--interface">
        <span>Interface / system view</span>
        <strong>Process, evidence, and architecture</strong>
      </article>
      <article class="imagery-slot imagery-slot--photo">
        <span>Authentic photography</span>
        <strong>Team, environments, and case-study proof</strong>
      </article>
    </div>
  </section>

  <section class="shell reference-section reference-guardrails" aria-labelledby="guardrails">
    <div>
      <p class="section-kicker">06 · GOVERNANCE</p>
      <h2 id="guardrails" class="section-title">When Storybook becomes worthwhile</h2>
    </div>
    <ul>
      <li>Adopt Storybook when components are shared by more than one application.</li>
      <li>Adopt it when state matrices, interaction tests, or visual-regression coverage outgrow this page.</li>
      <li>Until then, keep this reference close to production to avoid a second build and styling environment.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .reference-hero,
  .reference-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .reference-hero {
    max-inline-size: 58rem;
    margin-inline: auto;
  }
  .reference-section {
    border-block-start: 1px solid var(--border-subtle);
  }
  .reference-heading {
    max-inline-size: 48rem;
    margin-block-end: 2rem;
  }
  .token-grid,
  .type-grid,
  .surface-grid,
  .reference-capabilities,
  .imagery-grid {
    display: grid;
    gap: 1rem;
  }
  .token-grid {
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }
  .token-card,
  .reference-card,
  .reference-capability,
  .imagery-slot {
    border: 1px solid var(--border-subtle);
    border-radius: .5rem;
    background: var(--surface-panel);
  }
  .token-card {
    display: grid;
    gap: .5rem;
    padding: .75rem;
  }
  .token-swatch {
    display: block;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--border-subtle);
    border-radius: .25rem;
  }
  code {
    color: var(--color-muted);
  }
  .type-grid,
  .surface-grid,
  .imagery-grid {
    margin-block-start: 1rem;
  }
  .reference-card {
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .reference-label,
  .imagery-slot span {
    color: var(--color-amber);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .display-sample {
    margin-block: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1;
  }
  .body-sample,
  .reference-card p,
  .reference-capability p {
    color: var(--color-muted);
    line-height: 1.65;
  }
  .action-stack,
  .state-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }
  .action-stack {
    display: grid;
  }
  .action-stack .button-row {
    margin-block-start: 0;
  }
  .state-row .status-label {
    margin-block-end: 0;
  }
  .state-chip {
    border: 1px solid var(--color-steel);
    border-radius: 999px;
    padding: .5rem .75rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .state-chip--copper { border-color: var(--color-copper); }
  .reference-note { margin: 0; }
  .reference-capabilities {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .reference-capability {
    display: grid;
    gap: .75rem;
    padding: 1.5rem;
    transition: background-color .2s ease, transform .2s ease;
  }
  .reference-capability:hover {
    background: var(--surface-panel-strong);
    transform: translateY(-2px);
  }
  .reference-capability img {
    inline-size: 3rem;
    block-size: 3rem;
  }
  .reference-capability strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .reference-capability p { margin: 0; }
  .terminal-card code {
    display: block;
    margin-block-start: 1rem;
    color: var(--color-circuit);
    line-height: 1.8;
  }
  .imagery-slot {
    min-block-size: 13rem;
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: .75rem;
    padding: 1.5rem;
    overflow: hidden;
  }
  .imagery-slot--technical {
    background:
      radial-gradient(circle at 70% 30%, var(--color-amber) 0 .35rem, transparent .4rem),
      repeating-linear-gradient(90deg, transparent 0 2.75rem, var(--background-grid-inline) 2.75rem calc(2.75rem + 1px)),
      var(--surface-panel);
  }
  .imagery-slot--interface {
    background:
      linear-gradient(135deg, transparent 40%, var(--service-card-wash)),
      repeating-linear-gradient(0deg, transparent 0 2rem, var(--background-grid-block) 2rem calc(2rem + 1px)),
      var(--surface-panel);
  }
  .imagery-slot--photo {
    background: linear-gradient(145deg, var(--surface-panel-strong), var(--color-copper));
  }
  .reference-guardrails {
    display: grid;
    gap: 2rem;
  }
  .reference-guardrails ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-muted);
    line-height: 1.8;
  }
  @media (min-width: 48rem) {
    .type-grid { grid-template-columns: 1.2fr .8fr; }
    .surface-grid,
    .imagery-grid { grid-template-columns: repeat(3, 1fr); }
    .reference-guardrails { grid-template-columns: .8fr 1.2fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reference-capability { transition: none; }
  }
</style>
