---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getPostRouteParts, getVisiblePosts } from '../../../../lib/post-routes'

export async function getStaticPaths() {
  const postEntries = getVisiblePosts(await getCollection('posts'))

  return postEntries.map((postEntry) => ({
    params: getPostRouteParts(postEntry),
    props: { postEntry },
  }))
}

const { postEntry } = Astro.props
const { Content } = await render(postEntry)
const postCategories = Array.isArray(postEntry.data.categories)
  ? postEntry.data.categories
  : postEntry.data.categories
    ? [postEntry.data.categories]
    : []
---

<BaseLayout title={`${postEntry.data.title} | Skratsch Solutions`} description={postEntry.data.excerpt}>
  <article class="shell post-detail">
    <a class="service-back-link" href="/posts/">Building With Skratsch</a>
    <header class="post-detail-header">
      <div class="post-card-meta">
        <time datetime={postEntry.data.date.toISOString()}>{postEntry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
        {postCategories.length > 0 && <span>{postCategories.join(' / ')}</span>}
      </div>
      <h1 class="section-title">{postEntry.data.title}</h1>
      {postEntry.data.excerpt && <p class="service-hero-copy">{postEntry.data.excerpt}</p>}
      {postEntry.data.image && <img class="post-detail-image" src={postEntry.data.image} alt="" loading="eager" decoding="async" />}
    </header>
    <div class="prose-panel">
      <Content />
    </div>
  </article>
</BaseLayout>
