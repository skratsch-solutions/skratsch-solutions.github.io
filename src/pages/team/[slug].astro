---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { hasPlaceholderMarkdown } from '../../lib/content-quality'

export async function getStaticPaths() {
  const teamEntries = await getCollection('team')

  return teamEntries.map((teamEntry) => ({
    params: { slug: teamEntry.id },
    props: { teamEntry },
  }))
}

const { teamEntry } = Astro.props
const { Content } = await render(teamEntry)
const teamImage = teamEntry.data.image?.startsWith('/') ? teamEntry.data.image : `/${teamEntry.data.image}`
const shouldRenderBiography = !hasPlaceholderMarkdown(teamEntry.body)
const teamPageDescription = shouldRenderBiography ? teamEntry.data.jobtitle : 'Team and project staffing information'
---

<BaseLayout title={`${teamEntry.data.title} | Skratsch Solutions`} description={teamPageDescription} image={teamImage}>
  <article class="shell service-detail">
    <a class="service-back-link" href="/team/">Team</a>
    <div class="team-detail-header">
      {teamEntry.data.image && (
        <img
          class="team-detail-image"
          src={teamImage}
          alt=""
          loading="eager"
          decoding="async"
          width="360"
          height="360"
        />
      )}
      <div>
        <div class="section-kicker">{shouldRenderBiography ? teamEntry.data.jobtitle ?? 'Team' : 'Team'}</div>
        <h1 class="section-title">{teamEntry.data.title}</h1>
        {teamEntry.data.linkedinurl && (
          <p class="service-hero-copy">
            <a href={teamEntry.data.linkedinurl}>LinkedIn</a>
          </p>
        )}
      </div>
    </div>
    {shouldRenderBiography ? (
      <div class="prose-panel">
        <Content />
      </div>
    ) : (
      <div class="prose-panel">
        <p>Contact Skratsch Solutions for current team and project staffing information.</p>
      </div>
    )}
  </article>
</BaseLayout>
