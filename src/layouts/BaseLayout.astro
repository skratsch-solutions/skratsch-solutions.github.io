---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Technology that works for your business.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="shell flex items-center justify-between py-7 border-b border-white/10">
      <a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
        <span class="status-dot"></span>
        <span>Skratsch Solutions</span>
      </a>
      <nav class="hidden md:flex gap-7 text-sm text-[var(--muted)]" aria-label="Primary">
        <a href="#managed-it">Managed IT</a>
        <a href="#consulting">Consulting</a>
        <a href="#software">Software & Automation</a>
        <a href="#data-ai">Data & AI</a>
        <a href="#insights">Insights</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="shell py-10 mt-20 border-t border-white/10 text-sm text-[var(--muted)]">
      <div class="flex items-center gap-3"><span class="status-dot"></span><span>Skratsch Solutions · Skratsch.com</span></div>
    </footer>
  </body>
</html>
